# Environment Variables for Joe's AI - Multi-Provider Implementation
# Copy this to .env.local for local development or set via Render Dashboard

# ============================================================
# LLM PROVIDERS (At least one required)
# ============================================================

# Groq (Free, Fast) - https://console.groq.com/keys
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# OpenAI (Premium) - https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Anthropic Claude (Premium) - https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google Gemini (Free) - https://makersuite.google.com/app/apikey
# GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Replicate (Premium) - https://replicate.com/account/api-tokens
# REPLICATE_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# OPTIONAL: Chat History Sync (JSONBin.io)
# ============================================================
# Create a bin at https://jsonbin.io and get your credentials
# JSONBIN_BIN_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# JSONBIN_MASTER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# OPTIONAL: Google OAuth for Cloud Sync
# ============================================================
# Set up Google OAuth at: https://console.cloud.google.com/
# GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXTAUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# NEXTAUTH_URL=http://localhost:3000

# ============================================================
# Server Configuration
# ============================================================
NODE_ENV=development
PORT=3000