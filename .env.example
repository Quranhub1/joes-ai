fr# Environment Variables for Joe's AI - Render Deployment
# Copy this to .env.local for local development or set via Render Dashboard

# ============================================================
# AI PROVIDER API KEYS (Configure in Render Dashboard)
# ============================================================
# Get your keys from:
# - OpenAI:    https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/settings/keys
# - Google:    https://aistudio.google.com/apikey
# - Groq:      https://console.groq.com/keys

# Premium Providers (optional - app works without these using free providers)
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Free Providers (built-in - no keys required)
# - BazaarLink: https://bazaarlink.ai/keys
# - Completions.me: https://completions.me/dashboard
BAZAARLINK_API_KEY=sk-bl-optional-if-you-want-your-own-key
COMPLETIONS_API_KEY=sk-cp-optional-if-you-want-your-own-key

# ============================================================
# JSONBin.io for Chat History Sync (optional)
# ============================================================
# Create a bin at https://jsonbin.io and get your credentials
JSONBIN_BIN_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
JSONBIN_MASTER_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# NextAuth Google OAuth (optional - enables cloud sync)
# ============================================================
# Set up Google OAuth at: https://console.cloud.google.com/
# See GOOGLE_OAUTH_SETUP.md for detailed instructions
GOOGLE_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXTAUTH_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXTAUTH_URL=http://localhost:3000

# For production on Render, update NEXTAUTH_URL:
# NEXTAUTH_URL=https://joes-ai.onrender.com

# ============================================================
# Additional Free AI Providers (optional)
# ============================================================
# Together AI: https://www.together.ai/
TOGETHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Replicate: https://replicate.com/
REPLICATE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Cohere: https://cohere.ai/
COHERE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# DeepInfra: https://deepinfra.com/
DEEPINFRA_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Lepton AI: https://lepton.ai/
LEPTON_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Hugging Face: https://huggingface.co/
HUGGINGFACE_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================================
# Server Configuration
# ============================================================
NODE_ENV=development
PORT=3000